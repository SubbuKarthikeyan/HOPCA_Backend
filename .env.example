# ══════════════════════════════════════════════════════════════════════════════
# Hospital Operations & Patient Coordination Agent — Environment Configuration
# ══════════════════════════════════════════════════════════════════════════════

# ──────────────────────────────────────────────────────────────────────────────
# 1. LLM API KEYS
# ──────────────────────────────────────────────────────────────────────────────
# Groq API Key (from https://console.groq.com/)
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini API Key (from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Mistral AI API Key (from https://console.mistral.ai/)
MISTRAL_API_KEY=your_mistral_api_key_here

# DeepSeek API Key (from https://platform.deepseek.com/)
DEEPSEEK_API_KEY=your_deepseek_api_key_here


# ──────────────────────────────────────────────────────────────────────────────
# 2. CONFIGURE LLM MODELS & TYPES
# ──────────────────────────────────────────────────────────────────────────────

# --- Groq Models ---
# Fast & Recommended for General Hospital Chat: llama-3.3-70b-versatile
# Ultra-Fast / Low Latency: llama-3.1-8b-instant
# Reasoning / Medical Analysis: deepseek-r1-distill-llama-70b
# Vision / Multimodal: llama-3.2-11b-vision-preview
GROQ_MODEL=llama-3.3-70b-versatile

# --- Google Gemini Models ---
# Fast & Cost-Effective (Recommended): gemini-1.5-flash
# Complex Reasoning / Advanced Medical Triage: gemini-1.5-pro
# Next-Gen Flash Experimental: gemini-2.0-flash-exp
GEMINI_MODEL=gemini-1.5-flash

# --- Mistral AI Models ---
# Balanced & Fast (Recommended): mistral-small-latest
# High Performance Reasoning: mistral-large-latest
# Coding / Structured JSON Output: codestral-latest
MISTRAL_MODEL=mistral-small-latest

# --- DeepSeek Models ---
# General Chat & Instruction Following (Recommended): deepseek-chat
# Deep Reasoning & Chain-of-Thought: deepseek-reasoner
DEEPSEEK_MODEL=deepseek-chat


# ──────────────────────────────────────────────────────────────────────────────
# 3. RESILIENCE, RETRY & FALLBACK ORCHESTRATION
# ──────────────────────────────────────────────────────────────────────────────
# Priority order for fallback failover (tried left to right):
# Providers without valid API keys in this file will automatically be skipped.
LLM_PROVIDER_ORDER=["groq","gemini","mistral","deepseek"]

# Maximum retry attempts per provider for transient errors (HTTP 429, timeouts, 5xx)
LLM_MAX_RETRIES=2

# Exponential backoff factor (e.g., attempt 1 = ~1.5s delay, attempt 2 = ~3.0s delay)
LLM_BACKOFF_FACTOR=1.5

# Request timeout in seconds before triggering retry or next provider in chain
LLM_TIMEOUT_SECONDS=45.0


# ──────────────────────────────────────────────────────────────────────────────
# 4. APPLICATION SETTINGS
# ──────────────────────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO


# ──────────────────────────────────────────────────────────────────────────────
# 5. RAG DATA PREPARATION & EMBEDDINGS
# ──────────────────────────────────────────────────────────────────────────────
KNOWLEDGE_BASE_DIR=../knowledge_base
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
CHUNKING_STRATEGY=semantic
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSION=768
EMBEDDING_VERSION=1.0
EMBEDDING_BATCH_SIZE=20
DATA_DIR=./data

